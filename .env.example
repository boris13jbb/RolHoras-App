# =============================================================================
# SaaS Rol de Pagos — variables de entorno (valores ficticios)
# Copiar a .env y completar con secretos reales FUERA de Git.
# =============================================================================

APP_ENV=development
APP_NAME=rol-pagos-saas
API_PUBLIC_URL=http://localhost:8000
ADMIN_WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=rolpagos
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Docker Compose local)
DATABASE_URL=postgresql+asyncpg://rolpagos:rolpagos_dev@localhost:5433/rolpagos
DATABASE_URL_SYNC=postgresql://rolpagos:rolpagos_dev@localhost:5433/rolpagos

# Supabase Auth (JWT). En local se puede usar un secret de prueba.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-not-a-secret-for-clients
SUPABASE_JWT_SECRET=rol-pagos-dev-secret-local-minimo-32-chars
# NUNCA en Flutter ni en el cliente web:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Cifrado de refresh tokens / contraseñas PDF (Fernet URL-safe 32-byte key)
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
TOKEN_ENCRYPTION_KEY_VERSION=v1
# Opcional producción: GCP KMS / Secret Manager
GCP_PROJECT_ID=
GCP_KMS_KEY_NAME=
USE_GCP_SECRET_MANAGER=false

# Google OAuth (Web client) — backend only — valores ficticios
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_API_URL/api/v1/integrations/gmail/callback
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-push
GMAIL_PUBSUB_AUDIENCE=https://YOUR_API_URL/api/v1/webhooks/gmail/pubsub
GMAIL_WATCH_LABELS=INBOX

# Almacenamiento privado (local path o GCS)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/private
GCS_BUCKET=rol-pagos-private
SIGNED_URL_TTL_SECONDS=300

# Worker / cola
WORKER_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=5
PDF_MAX_BYTES=15728640

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Beta: permite /dev/bootstrap y cron de reconciliación
ENABLE_DEV_BOOTSTRAP=true
SCHEDULER_SECRET=change-me-scheduler-secret

# Pagos (adaptador; valores ficticios)
PAYMENT_PROVIDER=noop
KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_PRIVATE_MERCHANT_ID=
KUSHKI_WEBHOOK_SECRET=change-me-webhook-secret

# Observabilidad
LOG_LEVEL=INFO
SENTRY_DSN=
